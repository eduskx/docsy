# --- Datenbank (Neon) ---
# Neon gibt dir ZWEI Connection-Strings (Dashboard -> Connect):
#
# 1) POOLED (Host enthält "-pooler"): für die laufende App (Serverless-tauglich).
#    Läuft im Transaction-Mode -> Prepared Statements aus (in db.ts via prepare:false).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require"
#
# 2) DIRECT/UNPOOLED (Host OHNE "-pooler"): für Migrationen/DDL.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# --- Embeddings (Voyage AI) ---
# https://dashboard.voyageai.com/ -> API Keys
VOYAGE_API_KEY="pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Chat-LLM (Groq, kostenloser Tier) ---
# https://console.groq.com/ -> API Keys  (wird im Chat-Route-Handler genutzt)
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Chat-LLM Alternative (Anthropic / Claude) ---
# Optional: nur nötig, falls du CHAT_MODEL in route.ts zurück auf Claude stellst.
# https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Auth.js (NextAuth v5) ---
# AUTH_SECRET: einmalig generieren mit `npx auth secret` oder openssl rand -base64 32
AUTH_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# GitHub OAuth App: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:      http://localhost:3000
#   Callback URL:      http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="xxxxxxxxxxxxxxxxxxxx"
AUTH_GITHUB_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
